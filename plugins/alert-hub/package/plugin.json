{
  "apiVersion": 1,
  "hostApi": 2,
  "id": "alert-hub",
  "name": "告警中心",
  "version": "1.1.2",
  "description": "通过本机 MCP 管理告警、Case、待办、负责人和规则；独立插件界面，账号密码配置化，远端写入须确认。",
  "permissions": [
    "storage.read",
    "application.local",
    "conversation.compose"
  ],
  "page": {
    "title": "告警中心",
    "kind": "application"
  },
  "application": {
    "frontend": "ui.js",
    "styles": "ui.css",
    "backend": "server.mjs"
  },
  "records": {
    "storage": "private",
    "resourceType": "alert",
    "fields": [
      {
        "key": "title",
        "label": "标题",
        "type": "text",
        "required": true
      }
    ]
  },
  "commands": [],
  "configuration": {
    "fields": [
      {
        "key": "endpoint",
        "label": "Alert Hub 服务地址",
        "type": "text",
        "required": true,
        "default": "https://thor-alert-hub.hahavending.com",
        "description": "账号密码将用于此 HTTPS 服务的真实登录，请核对地址。"
      },
      {
        "key": "command",
        "label": "MCP 可执行文件",
        "type": "text",
        "required": true,
        "description": "填写本机 alert-hub-mcp 的绝对路径，例如 /Users/你的用户名/.local/bin/alert-hub-mcp。"
      },
      {
        "key": "username",
        "label": "账号",
        "type": "text",
        "required": true
      },
      {
        "key": "password",
        "label": "密码",
        "resetOnChange": [
          "endpoint",
          "username"
        ],
        "description": "留空保留原密码；更换服务地址或账号时必须重新填写。",
        "type": "password",
        "required": true
      }
    ]
  }
}
