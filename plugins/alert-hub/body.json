"\n  <div id=\"login-screen\" class=\"login-screen hidden\">\n    <div class=\"login-panel\">\n      <div class=\"login-brand\">Alert Hub</div>\n      <p class=\"hint\">内部告警运营控制台 · 请登录以继续</p>\n      <form id=\"login-form\">\n        <label>用户名 <input id=\"login-username\" type=\"text\" autocomplete=\"username\" required></label>\n        <label>密码 <input id=\"login-password\" type=\"password\" autocomplete=\"current-password\" required></label>\n        <button type=\"submit\" class=\"btn btn-primary\">登录</button>\n      </form>\n      <div id=\"login-error\" class=\"state error hidden\"></div>\n    </div>\n  </div>\n\n  <dialog id=\"password-dialog\" class=\"app-dialog\">\n    <form id=\"password-form\" method=\"dialog\">\n      <h3>修改密码</h3>\n      <p id=\"password-dialog-hint\" class=\"hint hidden\"></p>\n      <label>当前密码 <input id=\"password-old\" type=\"password\" autocomplete=\"current-password\" required></label>\n      <label>新密码 <input id=\"password-new\" type=\"password\" autocomplete=\"new-password\" required minlength=\"8\"></label>\n      <label>确认新密码 <input id=\"password-confirm\" type=\"password\" autocomplete=\"new-password\" required minlength=\"8\"></label>\n      <div id=\"password-error\" class=\"state error hidden\"></div>\n      <div id=\"password-success\" class=\"state success hidden\"></div>\n      <div class=\"dialog-actions\">\n        <button type=\"submit\" class=\"btn btn-primary\" id=\"password-save\">保存</button>\n        <button type=\"button\" id=\"password-cancel\" class=\"btn btn-secondary\">取消</button>\n      </div>\n    </form>\n  </dialog>\n\n  <div id=\"app-shell\" class=\"app-shell hidden\">\n    <aside class=\"sidebar\" aria-label=\"主导航\">\n      <div class=\"sidebar-brand\">\n        <span class=\"brand-mark\" aria-hidden=\"true\"></span>\n        <span class=\"brand-copy\">\n          <span class=\"brand-title\">Alert Hub</span>\n          <span class=\"brand-subtitle\">Incident command center</span>\n        </span>\n      </div>\n      <nav id=\"sidebar-nav\" class=\"sidebar-nav\" aria-label=\"页面导航\"></nav>\n    </aside>\n\n    <div class=\"main-area\">\n      <header class=\"topbar\">\n        <div class=\"topbar-left\">\n          <div class=\"topbar-heading\">\n            <h1 id=\"page-title\" class=\"page-title\">工作台</h1>\n            <p id=\"page-subtitle\" class=\"page-subtitle\">值班概览与处置健康</p>\n          </div>\n          <span id=\"refresh-indicator\" class=\"refresh-indicator\" title=\"数据刷新时间\"></span>\n        </div>\n        <div class=\"topbar-right\">\n          <div id=\"auth-user\" class=\"auth-user\"></div>\n          <button id=\"change-password-btn\" class=\"btn btn-sm btn-secondary hidden\" type=\"button\">改密码</button>\n          <label id=\"header-user-label\" class=\"header-user-label hidden\">\n            用户 <input id=\"user-id\" type=\"text\" placeholder=\"X-User-ID\">\n          </label>\n          <div id=\"user-profile\" class=\"user-profile hint\"></div>\n          <button id=\"global-refresh\" class=\"btn btn-sm\" type=\"button\" title=\"刷新当前页\">刷新</button>\n          <button id=\"logout-btn\" class=\"btn btn-sm btn-secondary hidden\" type=\"button\">退出</button>\n        </div>\n      </header>\n\n      <main id=\"app\" class=\"app-content\">\n        <section id=\"page-dashboard\" class=\"page active\">\n          <div class=\"dashboard-commandbar\">\n            <div class=\"dashboard-filter-grid\">\n              <select id=\"dashboard-scope\" aria-label=\"范围\">\n                <option value=\"all\">全部范围</option>\n                <option value=\"mine\">我的</option>\n                <option value=\"team\">我的团队</option>\n              </select>\n              <select id=\"dashboard-range\" aria-label=\"时间范围\">\n                <option value=\"24h\">近 24 小时</option>\n                <option value=\"7d\" selected>近 7 天</option>\n                <option value=\"30d\">近 30 天</option>\n              </select>\n              <select id=\"dashboard-team\" aria-label=\"团队\">\n                <option value=\"\">全部团队</option>\n              </select>\n              <select id=\"dashboard-service\" aria-label=\"服务\">\n                <option value=\"\">全部服务</option>\n              </select>\n              <select id=\"dashboard-severity\" aria-label=\"严重度\">\n                <option value=\"\">全部严重度</option>\n              </select>\n              <select id=\"dashboard-assignee\" aria-label=\"负责人\">\n                <option value=\"\">全部负责人</option>\n              </select>\n              <select id=\"dashboard-env\" aria-label=\"环境\">\n                <option value=\"\">全部环境</option>\n              </select>\n            </div>\n            <div class=\"dashboard-actions\">\n              <button id=\"dashboard-reset\" class=\"btn btn-secondary\" type=\"button\">重置</button>\n              <button id=\"dashboard-refresh\" class=\"btn btn-primary\" type=\"button\">应用筛选</button>\n            </div>\n          </div>\n          <div id=\"dashboard-loading\" class=\"state state-loading\">加载工作台数据…</div>\n          <div id=\"dashboard-error\" class=\"state error hidden\"></div>\n          <div id=\"dashboard-content\" class=\"hidden\">\n            <div class=\"command-summary\">\n              <div>\n                <span class=\"eyebrow\">Operations Command Center</span>\n                <h2>先看风险，再看归因，最后沉淀路由</h2>\n              </div>\n              <p class=\"hint\">Case 是可处置的问题单，Event 是每次发生记录；噪声 Case 默认不会进入值班队列。</p>\n            </div>\n\n            <div class=\"dashboard-kpi-groups\">\n              <section class=\"kpi-group kpi-risk\">\n                <div class=\"kpi-group-header\">\n                  <h3>当前风险</h3>\n                  <span>现在需要人响应</span>\n                </div>\n                <div class=\"metrics metrics-risk\">\n                  <button type=\"button\" class=\"metric metric-attention metric-drilldown\" data-kpi=\"open\" aria-label=\"Open Cases，查看 open 状态 Case\">\n                    <span class=\"label\">活跃 Case</span>\n                    <span id=\"m-open\" class=\"value\">0</span>\n                    <span class=\"metric-hint\">open / acked / triaged / fixing</span>\n                  </button>\n                  <button type=\"button\" class=\"metric metric-attention metric-drilldown\" data-kpi=\"unacked\" aria-label=\"Unacked，查看未确认 Case\">\n                    <span class=\"label\">待 ACK</span>\n                    <span id=\"m-unacked\" class=\"value\">0</span>\n                    <span class=\"metric-hint\">还没有负责人确认</span>\n                  </button>\n                  <button type=\"button\" class=\"metric metric-alert metric-drilldown\" data-kpi=\"ack-sla\" aria-label=\"查看 ACK SLA 超时 Case\">\n                    <span class=\"label\">ACK 超时</span>\n                    <span id=\"m-ack-sla\" class=\"value\">0</span>\n                    <span id=\"m-ack-sla-hint\" class=\"metric-hint\">未 ACK 超过 15 分钟</span>\n                  </button>\n                  <button type=\"button\" class=\"metric metric-alert metric-drilldown\" data-kpi=\"resolve-sla\" aria-label=\"查看解决 SLA 超时 Case\">\n                    <span class=\"label\">解决超时</span>\n                    <span id=\"m-resolve-sla\" class=\"value\">0</span>\n                    <span id=\"m-resolve-sla-hint\" class=\"metric-hint\">活跃超过 4 小时</span>\n                  </button>\n                </div>\n              </section>\n              <section class=\"kpi-group\">\n                <div class=\"kpi-group-header\">\n                  <h3>流量趋势</h3>\n                  <span id=\"dashboard-range-label\">近 7 天</span>\n                </div>\n                <div class=\"metrics metrics-flow\">\n                  <button type=\"button\" class=\"metric metric-drilldown\" data-kpi=\"all\" aria-label=\"查看当前范围 Case\">\n                    <span class=\"label\">新增 Case</span>\n                    <span id=\"m-new-cases\" class=\"value\">0</span>\n                  </button>\n                  <div class=\"metric\">\n                    <span class=\"label\">关闭 Case</span>\n                    <span id=\"m-closed-cases\" class=\"value\">0</span>\n                  </div>\n                  <button type=\"button\" class=\"metric metric-drilldown\" data-kpi=\"reopened\" aria-label=\"查看当前范围复发 Case\">\n                    <span class=\"label\">复发 Case</span>\n                    <span id=\"m-reopened-cases\" class=\"value\">0</span>\n                  </button>\n                  <div class=\"metric\">\n                    <span class=\"label\">事件</span>\n                    <span id=\"m-events\" class=\"value\">0</span>\n                  </div>\n                  <div class=\"metric\">\n                    <span class=\"label\">抑制事件</span>\n                    <span id=\"m-suppressed-events\" class=\"value\">0</span>\n                  </div>\n                </div>\n              </section>\n              <section class=\"kpi-group\">\n                <div class=\"kpi-group-header\">\n                  <h3>处置效率</h3>\n                  <span>ACK 含未确认等待</span>\n                </div>\n                <div class=\"metrics metrics-efficiency\">\n                  <div class=\"metric metric-with-hint\" title=\"已 ACK 按 Case 创建到首次 ACK 计算；未 ACK 按 Case 创建到当前时间计算\">\n                    <span class=\"label\">平均 ACK 时长</span>\n                    <span id=\"m-mtta\" class=\"value\">暂无样本</span>\n                    <span id=\"m-mtta-hint\" class=\"metric-hint\">统计已 ACK Case</span>\n                  </div>\n                  <div class=\"metric metric-with-hint\" title=\"当前时间范围内，Case 创建到标记解决/关闭的平均耗时\">\n                    <span class=\"label\">平均解决时长</span>\n                    <span id=\"m-mttr\" class=\"value\">暂无样本</span>\n                    <span id=\"m-mttr-hint\" class=\"metric-hint\">统计已解决 Case</span>\n                  </div>\n                </div>\n              </section>\n            </div>\n\n            <div class=\"dashboard-grid dashboard-grid-command\">\n              <div class=\"panel panel-priority\">\n                <div class=\"panel-header\">\n                  <div class=\"panel-header-main\">\n                    <h2>值班处置队列</h2>\n                    <span class=\"hint\">按严重度和最近发生排序</span>\n                  </div>\n                  <button id=\"reclassify-services\" class=\"btn btn-sm\" type=\"button\" title=\"根据 Owner、标签与告警文本重识别 unknown 服务\">重识别服务</button>\n                </div>\n                <div id=\"attention-loading\" class=\"state state-sm hidden\">加载队列…</div>\n                <div id=\"attention-empty\" class=\"empty-state hidden\">当前没有待处理 Case</div>\n                <div class=\"table-scroll\">\n                  <table class=\"table table-compact\" id=\"attention-queue\">\n                    <thead>\n                      <tr>\n                        <th>严重度</th>\n                        <th>服务</th>\n                        <th>标题</th>\n                        <th>状态</th>\n                        <th>负责人</th>\n                        <th>最近</th>\n                        <th></th>\n                      </tr>\n                    </thead>\n                    <tbody></tbody>\n                  </table>\n                </div>\n              </div>\n              <div class=\"panel panel-health\">\n                <div class=\"panel-header\">\n                  <h2>处置健康</h2>\n                  <button class=\"btn btn-sm btn-link\" type=\"button\" data-goto-page=\"diagnostics\">接入诊断</button>\n                </div>\n                <div id=\"ops-health\" class=\"ops-health-list\"></div>\n              </div>\n            </div>\n\n            <div class=\"dashboard-grid dashboard-grid-duty\">\n              <div class=\"panel\">\n                <div class=\"panel-header\">\n                  <div class=\"panel-header-main\">\n                    <h2>我的值班队列</h2>\n                    <span class=\"hint\">归属给当前登录人</span>\n                  </div>\n                  <button class=\"btn btn-sm btn-link\" type=\"button\" data-goto-page=\"my\">查看全部</button>\n                </div>\n                <div id=\"my-attention\" class=\"mini-case-list\"></div>\n              </div>\n              <div class=\"panel\">\n                <div class=\"panel-header\">\n                  <div class=\"panel-header-main\">\n                    <h2>团队告警队列</h2>\n                    <span class=\"hint\">按服务 Owner 团队归属</span>\n                  </div>\n                  <button class=\"btn btn-sm btn-link\" type=\"button\" data-goto-page=\"team\">查看全部</button>\n                </div>\n                <div id=\"team-attention\" class=\"mini-case-list\"></div>\n              </div>\n            </div>\n\n            <div class=\"dashboard-grid dashboard-grid-main\">\n              <div class=\"panel panel-trend\">\n                <div class=\"panel-header\">\n                  <div class=\"panel-header-main\">\n                    <h2>时间趋势</h2>\n                    <span id=\"dashboard-trend-range-label\" class=\"hint\">近 7 天</span>\n                  </div>\n                  <div class=\"trend-tools\">\n                    <div id=\"dashboard-trend-mode\" class=\"segmented-control\" role=\"tablist\" aria-label=\"趋势视角\">\n                      <button type=\"button\" class=\"active\" data-trend-mode=\"volume\">发生量</button>\n                      <button type=\"button\" data-trend-mode=\"backlog\">积压</button>\n                      <button type=\"button\" data-trend-mode=\"noise\">噪声</button>\n                      <button type=\"button\" data-trend-mode=\"service\">服务</button>\n                      <button type=\"button\" data-trend-mode=\"team\">团队</button>\n                      <button type=\"button\" data-trend-mode=\"person\">人员</button>\n                    </div>\n                    <div id=\"dashboard-trend-legend\" class=\"chart-legend\"></div>\n                  </div>\n                </div>\n                <div id=\"dashboard-trend-insights\" class=\"trend-insights\"></div>\n                <div id=\"dashboard-service-trend-toolbar\" class=\"service-trend-toolbar hidden\" aria-label=\"服务趋势曲线控制\"></div>\n                <div id=\"dashboard-trend\" class=\"trend-chart\" aria-label=\"告警趋势图\"></div>\n              </div>\n\n              <div class=\"panel panel-breakdowns\">\n                <div class=\"panel-header\">\n                  <h2>当前分布</h2>\n                </div>\n                <div class=\"breakdown-block\">\n                  <h3>状态</h3>\n                  <div id=\"status-breakdown\" class=\"bar-list\"></div>\n                </div>\n                <div class=\"breakdown-block\">\n                  <h3>严重度</h3>\n                  <div id=\"severity-breakdown\" class=\"bar-list\"></div>\n                </div>\n              </div>\n            </div>\n\n            <div class=\"grid-2 dashboard-grid-secondary\">\n              <div class=\"panel\">\n                <div class=\"panel-header\">\n                  <h2>团队看板</h2>\n                  <span class=\"hint\">按当前 Owner 归属</span>\n                </div>\n                <div class=\"table-scroll\">\n                  <table class=\"table table-compact table-dashboard\" id=\"team-breakdown\">\n                    <thead>\n                      <tr>\n                        <th>团队</th>\n                        <th>活跃</th>\n                        <th>新增</th>\n                        <th>关闭</th>\n                        <th>事件</th>\n                        <th>MTTA</th>\n                        <th>MTTR</th>\n                      </tr>\n                    </thead>\n                    <tbody></tbody>\n                  </table>\n                </div>\n              </div>\n              <div class=\"panel\">\n                <div class=\"panel-header\">\n                  <h2>服务目录健康</h2>\n                  <span class=\"hint\">点击服务查看 Case</span>\n                </div>\n                <div id=\"service-route-health\" class=\"service-route-health\"></div>\n                <div class=\"table-scroll\">\n                  <table class=\"table table-compact table-dashboard\" id=\"service-breakdown\">\n                    <thead>\n                      <tr>\n                        <th>服务</th>\n                        <th>团队</th>\n                        <th>Owner</th>\n                        <th>活跃</th>\n                        <th>事件</th>\n                        <th>MTTA</th>\n                      </tr>\n                    </thead>\n                    <tbody></tbody>\n                  </table>\n                </div>\n              </div>\n            </div>\n\n            <div class=\"grid-2 dashboard-grid-report\">\n              <div class=\"panel\">\n                <div class=\"panel-header\">\n                  <h2>团队日报指标</h2>\n                  <span class=\"hint\">近 24 小时</span>\n                </div>\n                <div id=\"report-daily\" class=\"report-grid\"></div>\n              </div>\n              <div class=\"panel\">\n                <div class=\"panel-header\">\n                  <h2>团队周报指标</h2>\n                  <span class=\"hint\">近 7 天</span>\n                </div>\n                <div id=\"report-weekly\" class=\"report-grid\"></div>\n              </div>\n            </div>\n\n            <p class=\"hint footnote\">首页统计按所选时间范围聚合；Case 是问题单，Event 是每次发生记录。</p>\n          </div>\n        </section>\n\n        <section id=\"page-cases\" class=\"page\">\n          <div class=\"toolbar filters case-filters\">\n            <div class=\"filter-row filter-row-main\">\n              <select id=\"case-view\" aria-label=\"Case 视图\">\n                <option value=\"active\" selected>活跃 Case</option>\n                <option value=\"noise\">噪声 Case</option>\n                <option value=\"closed\">已关闭 Case</option>\n                <option value=\"all\">全部 Case</option>\n              </select>\n              <select id=\"case-scope\" aria-label=\"范围\">\n                <option value=\"all\">全部</option>\n                <option value=\"mine\">我的</option>\n                <option value=\"team\">团队</option>\n              </select>\n              <input id=\"case-q\" placeholder=\"搜索标题/指纹\" aria-label=\"搜索\">\n              <select id=\"case-status\" aria-label=\"状态\">\n                <option value=\"\">全部状态</option>\n              </select>\n              <select id=\"case-service\" aria-label=\"服务\">\n                <option value=\"\">全部服务</option>\n              </select>\n              <select id=\"case-severity\" aria-label=\"严重度\">\n                <option value=\"\">全部严重度</option>\n              </select>\n              <div class=\"filter-actions\" aria-label=\"Case 操作\">\n                <button id=\"case-filter\" class=\"btn btn-primary\" type=\"button\">筛选</button>\n                <button id=\"case-export\" class=\"btn btn-secondary\" type=\"button\">导出</button>\n              </div>\n            </div>\n            <div class=\"filter-row filter-row-secondary\">\n              <select id=\"case-assignee\" aria-label=\"负责人\">\n                <option value=\"\">全部负责人</option>\n              </select>\n              <select id=\"case-env\" aria-label=\"环境\">\n                <option value=\"\">全部环境</option>\n              </select>\n              <div class=\"time-range-filter\" data-time-filter=\"case\" aria-label=\"最近活动时间范围\">\n                <span class=\"time-range-label\">最近活动</span>\n                <div class=\"time-preset-group\">\n                  <button type=\"button\" class=\"time-preset active\" data-time-target=\"case\" data-time-range=\"\">全部</button>\n                  <button type=\"button\" class=\"time-preset\" data-time-target=\"case\" data-time-range=\"1h\">近1h</button>\n                  <button type=\"button\" class=\"time-preset\" data-time-target=\"case\" data-time-range=\"24h\">近24h</button>\n                  <button type=\"button\" class=\"time-preset\" data-time-target=\"case\" data-time-range=\"7d\">近7d</button>\n                  <button type=\"button\" class=\"time-preset\" data-time-target=\"case\" data-time-range=\"custom\">自定义</button>\n                </div>\n                <div id=\"case-time-custom\" class=\"time-custom hidden\">\n                  <input id=\"case-from\" type=\"datetime-local\" aria-label=\"最近活动开始时间\">\n                  <span class=\"time-range-sep\" aria-hidden=\"true\">—</span>\n                  <input id=\"case-to\" type=\"datetime-local\" aria-label=\"最近活动结束时间\">\n                </div>\n              </div>\n              <div class=\"quick-filters\" id=\"case-quick-filters\">\n                <button type=\"button\" class=\"chip\" data-quick=\"open\">Open</button>\n                <button type=\"button\" class=\"chip\" data-quick=\"unacked\">Unacked</button>\n                <button type=\"button\" class=\"chip\" data-quick=\"mine\">我的</button>\n                <button type=\"button\" class=\"chip\" data-quick=\"critical\">Critical</button>\n              </div>\n            </div>\n          </div>\n          <div id=\"case-context\" class=\"filter-context hidden\"></div>\n\n          <div id=\"cases-loading\" class=\"state state-loading\">加载 Case 列表…</div>\n          <div id=\"cases-error\" class=\"state error hidden\"></div>\n          <div id=\"cases-empty\" class=\"empty-state hidden\">暂无 Case</div>\n\n          <div class=\"cases-layout hidden\" id=\"cases-content\">\n            <div class=\"cases-list-panel\">\n              <div class=\"list-table-scroll\">\n                <table class=\"table cases-table\" id=\"cases-table\">\n                  <thead>\n                    <tr>\n                      <th>级别</th>\n                      <th>状态</th>\n                      <th>服务</th>\n                      <th>标题</th>\n                      <th>负责人</th>\n                      <th>最近</th>\n                      <th>事件</th>\n                    </tr>\n                  </thead>\n                  <tbody></tbody>\n                </table>\n              </div>\n              <div class=\"list-pager\">\n                <span id=\"cases-pager\" class=\"pager-text\"></span>\n                <button type=\"button\" id=\"cases-load-more\" class=\"btn btn-sm btn-secondary hidden\">加载更多</button>\n              </div>\n            </div>\n\n            <aside id=\"case-detail\" class=\"detail-panel hidden\">\n              <div class=\"detail-header\">\n                <div class=\"detail-header-main\">\n                  <div class=\"detail-badges\" id=\"detail-badges\"></div>\n                  <h2 id=\"detail-title\" class=\"detail-title\"></h2>\n                  <div class=\"detail-meta\" id=\"detail-meta\"></div>\n                </div>\n                <button id=\"close-detail\" class=\"btn btn-sm btn-secondary\" type=\"button\" aria-label=\"关闭详情\">关闭</button>\n              </div>\n\n              <div class=\"detail-section\">\n                <div class=\"actions-primary\" id=\"detail-primary-action\"></div>\n                <div class=\"actions-secondary\" id=\"detail-actions\"></div>\n              </div>\n\n              <div class=\"detail-tabs\" id=\"case-detail-tabs\" role=\"tablist\" aria-label=\"Case 详情\">\n                <button type=\"button\" class=\"detail-tab-btn active\" data-detail-tab=\"overview\">概览</button>\n                <button type=\"button\" class=\"detail-tab-btn\" data-detail-tab=\"events\">事件</button>\n                <button type=\"button\" class=\"detail-tab-btn\" data-detail-tab=\"timeline\">时间线</button>\n                <button type=\"button\" class=\"detail-tab-btn\" data-detail-tab=\"raw\">原始数据</button>\n              </div>\n\n              <div id=\"detail-tab-overview\" class=\"detail-tab active\">\n                <div class=\"detail-section\">\n                  <h3>处置阶段</h3>\n                  <div id=\"detail-lifecycle\" class=\"lifecycle-steps\"></div>\n                </div>\n\n                <div class=\"detail-section inline-panel\" id=\"severity-panel\">\n                  <h3>严重度</h3>\n                  <form id=\"severity-form\" class=\"inline-form inline-form-row\">\n                    <select id=\"severity-select\" aria-label=\"严重度\">\n                      <option value=\"critical\">critical</option>\n                      <option value=\"high\">high</option>\n                      <option value=\"medium\">medium</option>\n                      <option value=\"low\">low</option>\n                    </select>\n                    <button type=\"submit\" class=\"btn btn-sm\" id=\"severity-submit\">更新</button>\n                  </form>\n                </div>\n\n                <div class=\"detail-section inline-panel\" id=\"assign-panel\">\n                  <h3>指派</h3>\n                  <form id=\"assign-form\" class=\"inline-form inline-form-row\">\n                    <select id=\"assign-input\" aria-label=\"Assignee\">\n                      <option value=\"\">选择负责人</option>\n                    </select>\n                    <button type=\"submit\" class=\"btn btn-sm\" id=\"assign-submit\">指派</button>\n                  </form>\n                </div>\n\n                <div class=\"detail-section inline-panel\" id=\"triage-panel\">\n                  <h3>分诊 / 备注</h3>\n                  <form id=\"triage-form\" class=\"inline-form\">\n                    <textarea id=\"triage-input\" rows=\"2\" placeholder=\"结论或处理备注\"></textarea>\n                    <div class=\"inline-form-row\">\n                      <button type=\"submit\" class=\"btn btn-sm\" id=\"triage-submit\" data-status=\"triaged\">标记已分诊</button>\n                      <button type=\"button\" class=\"btn btn-sm btn-secondary\" id=\"triage-fixing-btn\">标记修复中</button>\n                    </div>\n                  </form>\n                </div>\n\n                <div class=\"detail-section\">\n                  <h3>分组原因</h3>\n                  <div id=\"detail-grouping\" class=\"detail-text\"></div>\n                </div>\n\n                <div class=\"detail-section\">\n                  <h3>匹配规则</h3>\n                  <div id=\"detail-rules\" class=\"detail-text\"></div>\n                </div>\n\n                <div class=\"detail-section inline-panel\" id=\"merge-panel\">\n                  <h3>合并 Case</h3>\n                  <form id=\"merge-form\" class=\"inline-form inline-form-row\">\n                    <input id=\"merge-target-case-id\" placeholder=\"目标 Case ID\">\n                    <button type=\"submit\" class=\"btn btn-sm\" id=\"merge-submit\">合并</button>\n                  </form>\n                </div>\n              </div>\n\n              <div id=\"detail-tab-events\" class=\"detail-tab\">\n                <div class=\"detail-section\">\n                  <h3>关联事件</h3>\n                <div id=\"case-events-loading\" class=\"state state-sm hidden\">加载事件…</div>\n                <div id=\"case-events-error\" class=\"state error hidden\"></div>\n                <div id=\"case-events-empty\" class=\"empty-state hidden\">暂无关联事件</div>\n                <div class=\"table-scroll hidden\" id=\"case-events-wrap\">\n                  <table class=\"table table-compact\" id=\"case-events-table\">\n                    <thead>\n                      <tr>\n                        <th>接收时间</th>\n                        <th>级别</th>\n                        <th>Caller</th>\n                        <th>消息</th>\n                        <th>抑制</th>\n                      </tr>\n                    </thead>\n                    <tbody></tbody>\n                  </table>\n                </div>\n                </div>\n              </div>\n\n              <div id=\"detail-tab-timeline\" class=\"detail-tab\">\n                <div class=\"detail-section\">\n                  <h3>时间线</h3>\n                  <ul id=\"detail-history\" class=\"timeline\"></ul>\n                </div>\n\n                <div class=\"detail-section\">\n                  <h3>评论</h3>\n                  <ul id=\"detail-comments\" class=\"comments\"></ul>\n                  <form id=\"comment-form\" class=\"inline-form\">\n                    <textarea id=\"comment-body\" rows=\"2\" placeholder=\"添加评论\"></textarea>\n                    <button type=\"submit\" class=\"btn btn-sm\" id=\"comment-submit\">提交评论</button>\n                  </form>\n                </div>\n\n                <div class=\"detail-section\">\n                  <h3>关联 Todo</h3>\n                  <ul id=\"detail-todos\" class=\"comments\"></ul>\n                  <form id=\"case-todo-form\" class=\"inline-form inline-form-row\">\n                    <input id=\"case-todo-title\" placeholder=\"Todo 标题（默认用 Case 标题）\">\n                    <button type=\"submit\" class=\"btn btn-sm\" id=\"case-todo-submit\">创建 Todo</button>\n                  </form>\n                </div>\n              </div>\n\n              <div id=\"detail-tab-raw\" class=\"detail-tab\">\n                <details class=\"detail-collapse\" open>\n                  <summary>样本事件 JSON</summary>\n                  <pre id=\"detail-event\" class=\"code\"></pre>\n                </details>\n\n                <details class=\"detail-collapse\" open>\n                  <summary>原始载荷（已脱敏）</summary>\n                  <pre id=\"detail-raw\" class=\"code\"></pre>\n                </details>\n              </div>\n            </aside>\n          </div>\n        </section>\n\n        <section id=\"page-events\" class=\"page\">\n          <div class=\"toolbar filters\">\n            <input id=\"event-q\" placeholder=\"搜索服务/caller/消息\" aria-label=\"搜索\">\n            <select id=\"event-service\" aria-label=\"服务\">\n              <option value=\"\">全部服务</option>\n            </select>\n            <select id=\"event-env\" aria-label=\"环境\">\n              <option value=\"\">全部环境</option>\n            </select>\n            <select id=\"event-suppressed\" aria-label=\"抑制\">\n              <option value=\"\">全部抑制状态</option>\n              <option value=\"true\">已抑制</option>\n              <option value=\"false\">未抑制</option>\n            </select>\n            <input id=\"event-case-id\" placeholder=\"Case ID\" aria-label=\"Case ID\">\n            <div class=\"time-range-filter\" data-time-filter=\"event\" aria-label=\"接收时间范围\">\n              <span class=\"time-range-label\">接收时间</span>\n              <div class=\"time-preset-group\">\n                <button type=\"button\" class=\"time-preset active\" data-time-target=\"event\" data-time-range=\"\">全部</button>\n                <button type=\"button\" class=\"time-preset\" data-time-target=\"event\" data-time-range=\"1h\">近1h</button>\n                <button type=\"button\" class=\"time-preset\" data-time-target=\"event\" data-time-range=\"24h\">近24h</button>\n                <button type=\"button\" class=\"time-preset\" data-time-target=\"event\" data-time-range=\"7d\">近7d</button>\n                <button type=\"button\" class=\"time-preset\" data-time-target=\"event\" data-time-range=\"custom\">自定义</button>\n              </div>\n              <div id=\"event-time-custom\" class=\"time-custom hidden\">\n                <input id=\"event-from\" type=\"datetime-local\" aria-label=\"接收开始时间\">\n                <span class=\"time-range-sep\" aria-hidden=\"true\">—</span>\n                <input id=\"event-to\" type=\"datetime-local\" aria-label=\"接收结束时间\">\n              </div>\n            </div>\n            <div class=\"filter-actions\" aria-label=\"事件操作\">\n              <button id=\"event-filter\" class=\"btn btn-primary\" type=\"button\">筛选</button>\n              <button id=\"event-export\" class=\"btn btn-secondary\" type=\"button\">导出</button>\n            </div>\n          </div>\n\n          <div id=\"events-loading\" class=\"state state-loading\">加载事件流…</div>\n          <div id=\"events-error\" class=\"state error hidden\"></div>\n          <div id=\"events-empty\" class=\"empty-state hidden\">暂无事件</div>\n          <div class=\"panel table-panel hidden\" id=\"events-content\">\n            <div class=\"list-table-scroll\">\n              <table class=\"table\" id=\"events-table\">\n                <thead>\n                  <tr>\n                    <th>接收时间</th>\n                    <th>归属 Case</th>\n                    <th>服务</th>\n                    <th>事件摘要</th>\n                    <th>来源</th>\n                    <th>处理结果</th>\n                  </tr>\n                </thead>\n                <tbody></tbody>\n              </table>\n            </div>\n            <div class=\"list-pager\">\n              <span id=\"events-pager\" class=\"pager-text\"></span>\n              <button type=\"button\" id=\"events-load-more\" class=\"btn btn-sm btn-secondary hidden\">加载更多</button>\n            </div>\n          </div>\n        </section>\n\n        <section id=\"page-todos\" class=\"page\">\n          <div class=\"toolbar filters\">\n            <select id=\"todo-scope\" aria-label=\"范围\">\n              <option value=\"all\">全部</option>\n              <option value=\"mine\">我的</option>\n              <option value=\"team\">团队</option>\n            </select>\n            <select id=\"todo-status\" aria-label=\"状态\">\n              <option value=\"\">状态</option>\n              <option>open</option>\n              <option>doing</option>\n              <option>done</option>\n              <option>canceled</option>\n            </select>\n            <input id=\"todo-owner\" placeholder=\"Owner\" aria-label=\"Owner\">\n            <input id=\"todo-team\" placeholder=\"Team\" aria-label=\"Team\">\n            <input id=\"todo-service\" placeholder=\"Service\" aria-label=\"Service\">\n            <input id=\"todo-q\" placeholder=\"搜索\" aria-label=\"搜索\">\n            <button id=\"todo-filter\" class=\"btn btn-primary\" type=\"button\">筛选</button>\n          </div>\n\n          <div id=\"todos-loading\" class=\"state state-loading\">加载 Todo…</div>\n          <div id=\"todos-error\" class=\"state error hidden\"></div>\n          <div id=\"todos-empty\" class=\"empty-state hidden\">暂无 Todo</div>\n          <div class=\"panel table-panel hidden\" id=\"todos-content\">\n            <table class=\"table\" id=\"todos-table\">\n              <thead>\n                <tr>\n                  <th>标题</th>\n                  <th>状态</th>\n                  <th>优先级</th>\n                  <th>Owner</th>\n                  <th>Team</th>\n                  <th>Service</th>\n                  <th>截止</th>\n                  <th>Case</th>\n                  <th>操作</th>\n                </tr>\n              </thead>\n              <tbody></tbody>\n            </table>\n            <div class=\"list-pager\">\n              <span id=\"todos-pager\" class=\"pager-text\"></span>\n              <button type=\"button\" id=\"todos-load-more\" class=\"btn btn-sm btn-secondary hidden\">加载更多</button>\n            </div>\n          </div>\n        </section>\n\n        <section id=\"page-owners\" class=\"page\">\n          <div class=\"page-toolbar\">\n            <p class=\"hint\">维护服务路由、负责人和企微通知目标</p>\n            <div class=\"toolbar-actions\">\n              <button id=\"owner-open-people\" class=\"btn btn-secondary\" type=\"button\">人员目录</button>\n              <button id=\"owner-new\" class=\"btn btn-primary\" type=\"button\">新建路由</button>\n            </div>\n          </div>\n          <div id=\"owners-loading\" class=\"state state-loading\">加载 Owner…</div>\n          <div id=\"owners-error\" class=\"state error hidden\"></div>\n          <div id=\"owners-empty\" class=\"empty-state hidden\">暂无 Owner 配置</div>\n          <div class=\"panel table-panel hidden\" id=\"owners-content\">\n            <table class=\"table\" id=\"owners-table\">\n              <thead>\n                <tr>\n                  <th>服务</th>\n                  <th>Primary</th>\n                  <th>Backup</th>\n                  <th>Team</th>\n                  <th>企微ID</th>\n                  <th>Case</th>\n                  <th>启用</th>\n                  <th>操作</th>\n                </tr>\n              </thead>\n              <tbody></tbody>\n            </table>\n          </div>\n\n          <dialog id=\"owner-dialog\" class=\"app-dialog\">\n            <form id=\"owner-form\" method=\"dialog\">\n              <h3>Service Owner</h3>\n              <input type=\"hidden\" id=\"owner-id\">\n              <label>Service <input id=\"owner-service\" required></label>\n              <label>Primary\n                <input id=\"owner-primary\" list=\"people-usernames\" required autocomplete=\"off\">\n                <span id=\"owner-primary-meta\" class=\"owner-person-meta\"></span>\n              </label>\n              <label>Backup\n                <input id=\"owner-backup\" list=\"people-usernames\" autocomplete=\"off\">\n                <span id=\"owner-backup-meta\" class=\"owner-person-meta\"></span>\n              </label>\n              <datalist id=\"people-usernames\"></datalist>\n              <div class=\"owner-derived-grid\">\n                <label>服务责任团队\n                  <span class=\"owner-team-control\">\n                    <select id=\"owner-team\"></select>\n                    <input id=\"owner-team-free\" class=\"hidden\" maxlength=\"128\" placeholder=\"未登记团队名称\" aria-label=\"服务未登记团队名称\">\n                    <button type=\"button\" id=\"owner-team-follow\" class=\"btn btn-sm btn-link hidden\">使用负责人团队</button>\n                  </span>\n                </label>\n                <label>企微ID <input id=\"owner-notify\" readonly aria-readonly=\"true\" placeholder=\"企业微信 userid\"></label>\n              </div>\n              <p id=\"owner-routing-hint\" class=\"owner-routing-hint\"></p>\n              <label class=\"checkbox-label\"><input type=\"checkbox\" id=\"owner-enabled\" checked> 启用</label>\n              <div class=\"dialog-actions\">\n                <button type=\"submit\" class=\"btn btn-primary\" id=\"owner-save\">保存</button>\n                <button type=\"button\" id=\"owner-cancel\" class=\"btn btn-secondary\">取消</button>\n              </div>\n            </form>\n          </dialog>\n        </section>\n\n        <section id=\"page-people\" class=\"page\">\n          <div class=\"page-toolbar\">\n            <p class=\"hint\">维护告警负责人目录；Case 指派仅可选择启用中的人员</p>\n            <button id=\"person-new\" class=\"btn btn-primary\" type=\"button\">新建人员</button>\n          </div>\n          <div id=\"people-loading\" class=\"state state-loading\">加载人员…</div>\n          <div id=\"people-error\" class=\"state error hidden\"></div>\n          <div id=\"people-empty\" class=\"empty-state hidden\">暂无人员</div>\n          <div class=\"panel table-panel hidden\" id=\"people-content\">\n            <table class=\"table\" id=\"people-table\">\n              <thead>\n                <tr>\n                  <th>用户名</th>\n                  <th>姓名</th>\n                  <th>邮箱</th>\n                  <th>Team</th>\n                  <th>JIRA 账号</th>\n                  <th>企微ID</th>\n                  <th>状态</th>\n                  <th>来源</th>\n                  <th>操作</th>\n                </tr>\n              </thead>\n              <tbody></tbody>\n            </table>\n          </div>\n\n          <dialog id=\"person-dialog\" class=\"app-dialog\">\n            <form id=\"person-form\" method=\"dialog\">\n              <h3>人员</h3>\n              <input type=\"hidden\" id=\"person-id\">\n              <label>用户名 <input id=\"person-username\" required></label>\n              <label>姓名 <input id=\"person-name\"></label>\n              <label>邮箱 <input id=\"person-email\" type=\"email\"></label>\n              <label>人员团队\n                <select id=\"person-team\">\n                  <option value=\"\">未绑定团队</option>\n                </select>\n              </label>\n              <input id=\"person-team-free\" class=\"hidden\" maxlength=\"128\" placeholder=\"未登记团队名称\" aria-label=\"人员未登记团队名称\">\n              <label>JIRA 账号 <input id=\"person-jira\" placeholder=\"用于后续自动创建 Jira 任务\"></label>\n              <p id=\"person-account-note\" class=\"hint\">本地登录账号与用户名一致；首次开通默认密码由管理员统一发放。</p>\n              <label>企微ID <input id=\"person-wecom\"></label>\n              <label>状态\n                <select id=\"person-status\">\n                  <option value=\"active\">启用</option>\n                  <option value=\"disabled\">停用</option>\n                </select>\n              </label>\n              <div class=\"dialog-actions\">\n                <button type=\"submit\" class=\"btn btn-primary\" id=\"person-save\">保存</button>\n                <button type=\"button\" id=\"person-cancel\" class=\"btn btn-secondary\">取消</button>\n              </div>\n            </form>\n          </dialog>\n        </section>\n\n        <section id=\"page-teams\" class=\"page\">\n          <div class=\"page-toolbar\">\n            <p class=\"hint\">团队目录与服务责任归属</p>\n            <button id=\"team-new\" class=\"btn btn-primary\" type=\"button\">新建团队</button>\n          </div>\n          <div id=\"teams-loading\" class=\"state state-loading\">加载团队…</div>\n          <div id=\"teams-error\" class=\"state error hidden\"></div>\n          <div id=\"teams-empty\" class=\"empty-state hidden\">暂无团队</div>\n          <div class=\"panel table-panel hidden\" id=\"teams-content\">\n            <table class=\"table\" id=\"teams-table\">\n              <thead>\n                <tr>\n                  <th>团队名</th>\n                  <th>显示名</th>\n                  <th>成员</th>\n                  <th>服务</th>\n                  <th>Jira 项目</th>\n                  <th>默认经办人</th>\n                  <th>启用</th>\n                  <th>操作</th>\n                </tr>\n              </thead>\n              <tbody></tbody>\n            </table>\n          </div>\n\n          <dialog id=\"team-dialog\" class=\"app-dialog\">\n            <form id=\"team-form\" method=\"dialog\">\n              <h3>团队</h3>\n              <input type=\"hidden\" id=\"team-id\">\n              <label>团队名 <input id=\"team-name\" required></label>\n              <label>显示名 <input id=\"team-display-name\"></label>\n              <label>Jira 项目 Key <input id=\"team-jira-project\"></label>\n              <label>默认经办人/JIRA 账号 <input id=\"team-default-assignee\"></label>\n              <label>描述 <textarea id=\"team-description\" rows=\"3\"></textarea></label>\n              <input id=\"team-enabled\" type=\"hidden\">\n              <div class=\"dialog-actions\">\n                <button type=\"submit\" class=\"btn btn-primary\" id=\"team-save\">保存</button>\n                <button type=\"button\" id=\"team-cancel\" class=\"btn btn-secondary\">取消</button>\n              </div>\n            </form>\n          </dialog>\n          <dialog id=\"team-manage-dialog\" class=\"app-dialog team-manage-dialog\" aria-labelledby=\"team-manage-title\">\n            <form id=\"team-manage-form\">\n              <h3 id=\"team-manage-title\">团队引用与变更</h3>\n              <p id=\"team-manage-name\"></p>\n              <div id=\"team-manage-loading\" class=\"state\">正在核对引用…</div>\n              <div id=\"team-manage-error\" class=\"state error hidden\" role=\"alert\"></div>\n              <button id=\"team-manage-retry\" type=\"button\" class=\"btn hidden\">重试</button>\n              <dl id=\"team-manage-usage\" class=\"team-usage-grid\"></dl>\n              <p id=\"team-manage-services\" class=\"hint\"></p>\n              <label>变更方式\n                <select id=\"team-manage-mode\">\n                  <option value=\"merge\">合并到其他团队</option>\n                  <option value=\"toggle\">停用团队</option>\n                  <option value=\"delete\">删除无引用团队</option>\n                </select>\n              </label>\n              <label id=\"team-merge-target-label\">目标团队 <select id=\"team-merge-target\"></select></label>\n              <p id=\"team-manage-impact\" class=\"hint\"></p>\n              <label class=\"checkbox-label\"><input id=\"team-manage-confirm\" type=\"checkbox\" required> 确认上述影响</label>\n              <div class=\"dialog-actions\">\n                <button id=\"team-manage-submit\" type=\"submit\" class=\"btn btn-primary\" disabled>确认变更</button>\n                <button id=\"team-manage-close\" type=\"button\" class=\"btn btn-secondary\">取消</button>\n              </div>\n            </form>\n          </dialog>\n        </section>\n\n        <section id=\"page-rules\" class=\"page\">\n          <div class=\"page-toolbar\">\n            <p class=\"hint\">规则支持先 Dry-run，再保存为抑制、降级、路由或打标策略</p>\n            <button id=\"rule-new\" class=\"btn btn-primary\" type=\"button\">新建规则</button>\n          </div>\n          <div id=\"rules-loading\" class=\"state state-loading\">加载规则…</div>\n          <div id=\"rules-error\" class=\"state error hidden\"></div>\n          <div id=\"rules-empty\" class=\"empty-state hidden\">暂无规则</div>\n          <div class=\"panel table-panel hidden\" id=\"rules-content\">\n            <table class=\"table\" id=\"rules-table\">\n              <thead>\n                <tr>\n                  <th>名称</th>\n                  <th>动作</th>\n                  <th>优先级</th>\n                  <th>启用</th>\n                  <th>命中</th>\n                  <th>操作</th>\n                </tr>\n              </thead>\n              <tbody></tbody>\n            </table>\n          </div>\n\n          <dialog id=\"rule-dialog\" class=\"app-dialog\">\n            <form id=\"rule-form\" method=\"dialog\">\n              <h3>告警规则</h3>\n              <input type=\"hidden\" id=\"rule-id\">\n              <label>名称 <input id=\"rule-name\" required></label>\n              <label>动作 <select id=\"rule-action\"><option>suppress</option><option>downgrade</option><option>route</option><option>tag</option></select></label>\n              <label>优先级 <input id=\"rule-priority\" type=\"number\" value=\"100\"></label>\n              <label>原因 <textarea id=\"rule-reason\" rows=\"2\"></textarea></label>\n              <label>Service <input id=\"rule-service\"></label>\n              <label>Callers <input id=\"rule-callers\" placeholder=\"逗号分隔\"></label>\n              <label>Msg contains <input id=\"rule-msg\"></label>\n              <label>Error contains <input id=\"rule-error\"></label>\n              <label class=\"checkbox-label\"><input type=\"checkbox\" id=\"rule-enabled\"> 启用</label>\n              <div class=\"dialog-actions\">\n                <button type=\"button\" id=\"rule-dryrun\" class=\"btn btn-secondary\">Dry-run</button>\n                <button type=\"submit\" class=\"btn btn-primary\" id=\"rule-save\">保存</button>\n                <button type=\"button\" id=\"rule-cancel\" class=\"btn btn-secondary\">取消</button>\n              </div>\n              <pre id=\"rule-dryrun-result\" class=\"code hidden\"></pre>\n            </form>\n          </dialog>\n        </section>\n\n        <section id=\"page-fingerprints\" class=\"page\">\n          <div class=\"page-toolbar\">\n            <p class=\"hint\">用正则归一化服务日志里的动态片段；保存启用规则后会自动合并最近受影响的活跃 Case</p>\n            <div class=\"toolbar-actions\">\n              <button id=\"fingerprint-refresh\" class=\"btn btn-secondary\" type=\"button\">刷新</button>\n              <button id=\"fingerprint-rule-new\" class=\"btn btn-primary\" type=\"button\">新建指纹规则</button>\n            </div>\n          </div>\n          <div id=\"fingerprints-auto-merge-result\" class=\"state state-sm hidden\"></div>\n          <div id=\"fingerprints-loading\" class=\"state state-loading\">加载指纹规则…</div>\n          <div id=\"fingerprints-error\" class=\"state error hidden\"></div>\n          <div id=\"fingerprints-empty\" class=\"empty-state hidden\">暂无指纹规则</div>\n          <div class=\"panel table-panel hidden\" id=\"fingerprints-content\">\n            <table class=\"table\" id=\"fingerprints-table\">\n              <thead>\n                <tr>\n                  <th>名称</th>\n                  <th>范围</th>\n                  <th>字段</th>\n                  <th>正则</th>\n                  <th>替换为</th>\n                  <th>优先级</th>\n                  <th>启用</th>\n                  <th>命中</th>\n                  <th>操作</th>\n                </tr>\n              </thead>\n              <tbody></tbody>\n            </table>\n          </div>\n\n          <dialog id=\"fingerprint-rule-dialog\" class=\"app-dialog wide-dialog\">\n            <form id=\"fingerprint-rule-form\" method=\"dialog\">\n              <h3>指纹归并规则</h3>\n              <input type=\"hidden\" id=\"fingerprint-rule-id\">\n              <label>名称 <input id=\"fingerprint-rule-name\" required placeholder=\"trade-consumer activity_no 归一化\"></label>\n              <label>说明 <input id=\"fingerprint-rule-description\" placeholder=\"适用错误格式和处理口径\"></label>\n              <div class=\"form-grid two\">\n                <label>环境 <input id=\"fingerprint-rule-environment\" placeholder=\"留空表示全部环境\"></label>\n                <label>服务\n                  <input id=\"fingerprint-rule-service\" placeholder=\"输入或选择服务\" list=\"fingerprint-service-options\">\n                  <datalist id=\"fingerprint-service-options\"></datalist>\n                </label>\n              </div>\n              <div class=\"form-grid two\">\n                <label>归一化字段\n                  <select id=\"fingerprint-rule-field\">\n                    <option value=\"msg\">消息 msg</option>\n                    <option value=\"error\">错误 error</option>\n                    <option value=\"caller\">调用位置 caller（行号漂移归并）</option>\n                    <option value=\"function\">函数 function</option>\n                    <option value=\"path\">路径 path</option>\n                    <option value=\"fingerprint\">最终指纹 fingerprint</option>\n                  </select>\n                </label>\n                <label>优先级 <input id=\"fingerprint-rule-priority\" type=\"number\" value=\"100\"></label>\n              </div>\n              <p id=\"fingerprint-rule-caller-hint\" class=\"hint hidden\">caller 归并用于同一根因因代码变更导致行号漂移的场景：仅归一化调用位置中的动态行号，消息/错误根因仍保留在最终指纹中，不会因服务相同就将 EOF、超时等不同错误合并。</p>\n              <label>匹配正则 <input id=\"fingerprint-rule-pattern\" required placeholder=\"activity_no[A-Z]?[0-9]{8,}\"></label>\n              <label>替换为 <input id=\"fingerprint-rule-replacement\" placeholder=\"activity_no=&lt;redacted&gt;\"></label>\n              <div class=\"form-grid two\">\n                <label>样本 A 消息 <textarea id=\"fingerprint-rule-sample-a\" rows=\"4\" placeholder=\"粘贴一条原始告警消息\"></textarea></label>\n                <label>样本 B 消息 <textarea id=\"fingerprint-rule-sample-b\" rows=\"4\" placeholder=\"粘贴另一条只含动态差异的消息\"></textarea></label>\n              </div>\n              <div id=\"fingerprint-rule-sample-callers\" class=\"form-grid two hidden\">\n                <label>样本 A caller <input id=\"fingerprint-rule-sample-a-caller\" placeholder=\"video_service.go:748\" autocomplete=\"off\"></label>\n                <label>样本 B caller <input id=\"fingerprint-rule-sample-b-caller\" placeholder=\"video_service.go:801\" autocomplete=\"off\"></label>\n              </div>\n              <label class=\"checkbox-label\"><input type=\"checkbox\" id=\"fingerprint-rule-enabled\" checked> 启用</label>\n              <div class=\"dialog-actions\">\n                <button type=\"button\" id=\"fingerprint-rule-preview\" class=\"btn btn-secondary\">预览样本</button>\n                <button type=\"button\" id=\"fingerprint-rule-dryrun\" class=\"btn btn-secondary\">最近事件 Dry-run</button>\n                <button type=\"submit\" class=\"btn btn-primary\" id=\"fingerprint-rule-save\">保存</button>\n                <button type=\"button\" id=\"fingerprint-rule-cancel\" class=\"btn btn-secondary\">取消</button>\n              </div>\n              <pre id=\"fingerprint-rule-preview-result\" class=\"code hidden\"></pre>\n            </form>\n          </dialog>\n        </section>\n\n        <section id=\"page-notifications\" class=\"page\">\n          <div class=\"page-toolbar\">\n            <p id=\"notification-routing-hint\" class=\"notification-routing-hint hint\">加载通知路由状态…</p>\n            <div class=\"toolbar-actions\">\n              <button id=\"notifications-refresh\" class=\"btn btn-secondary\" type=\"button\">刷新</button>\n              <button id=\"notification-channel-new\" class=\"btn btn-primary\" type=\"button\">新建渠道</button>\n              <button id=\"notification-policy-new\" class=\"btn btn-secondary\" type=\"button\">新建策略</button>\n              <button id=\"notification-route-new\" class=\"btn btn-secondary\" type=\"button\">配置服务通知</button>\n            </div>\n          </div>\n          <div id=\"notifications-loading\" class=\"state state-loading\">加载通知策略…</div>\n          <div id=\"notifications-error\" class=\"state error hidden\"></div>\n          <div id=\"notifications-empty\" class=\"empty-state hidden\">暂无通知配置</div>\n          <div id=\"notifications-content\" class=\"hidden\">\n            <div class=\"panel table-panel\">\n              <div class=\"panel-header\"><h2>渠道</h2></div>\n              <table class=\"table\" id=\"notification-channels-table\">\n                <thead><tr><th>名称</th><th>类型</th><th>提供商</th><th>启用</th><th>优先级</th><th>操作</th></tr></thead>\n                <tbody></tbody>\n              </table>\n            </div>\n            <div class=\"panel table-panel\">\n              <div class=\"panel-header\"><h2>策略</h2></div>\n              <table class=\"table\" id=\"notification-policies-table\">\n                <thead><tr><th>名称</th><th>描述</th><th>规则数</th><th>启用</th><th>默认</th><th>操作</th></tr></thead>\n                <tbody></tbody>\n              </table>\n            </div>\n            <div class=\"panel table-panel\">\n              <div class=\"panel-header\">\n                <h2>服务路由</h2>\n                <p class=\"panel-hint\">按服务覆盖默认策略；未列出的服务走默认策略或 legacy notify.wecom</p>\n              </div>\n              <table class=\"table\" id=\"notification-routes-table\">\n                <thead><tr><th>服务</th><th>策略</th><th>启用</th><th>操作</th></tr></thead>\n                <tbody></tbody>\n              </table>\n            </div>\n            <div class=\"panel table-panel\">\n              <div class=\"panel-header\"><h2>投递记录</h2></div>\n              <table class=\"table table-compact\" id=\"notification-deliveries-table\">\n                <thead><tr><th>时间</th><th>Case</th><th>策略</th><th>渠道</th><th>状态</th><th>错误</th></tr></thead>\n                <tbody></tbody>\n              </table>\n            </div>\n          </div>\n          <dialog id=\"notification-channel-dialog\" class=\"app-dialog\">\n            <form id=\"notification-channel-form\" method=\"dialog\">\n              <h3>通知渠道</h3>\n              <input type=\"hidden\" id=\"notification-channel-id\">\n              <label>名称 <input id=\"notification-channel-name\" required></label>\n              <label>类型 <select id=\"notification-channel-type\"><option value=\"wecom_group\">企微群机器人</option></select></label>\n              <label>提供商\n                <select id=\"notification-channel-provider\">\n                  <option value=\"wecom\">企微群 Webhook</option>\n                </select>\n              </label>\n              <label>目标 <input id=\"notification-channel-target\" placeholder=\"企微群机器人 Webhook\"></label>\n              <label>优先级 <input id=\"notification-channel-priority\" type=\"number\" value=\"100\"></label>\n              <label class=\"checkbox-label\"><input type=\"checkbox\" id=\"notification-channel-enabled\" checked> 启用</label>\n              <div class=\"dialog-actions\">\n                <button type=\"submit\" class=\"btn btn-primary\" id=\"notification-channel-save\">保存</button>\n                <button type=\"button\" id=\"notification-channel-cancel\" class=\"btn btn-secondary\">取消</button>\n              </div>\n            </form>\n          </dialog>\n          <dialog id=\"notification-policy-dialog\" class=\"app-dialog\">\n            <form id=\"notification-policy-form\" method=\"dialog\">\n              <h3>通知策略</h3>\n              <input type=\"hidden\" id=\"notification-policy-id\">\n              <input type=\"hidden\" id=\"notification-policy-rule-id\">\n              <label>名称 <input id=\"notification-policy-name\" required placeholder=\"P0 企微群\"></label>\n              <label>说明 <input id=\"notification-policy-description\" placeholder=\"适用场景、升级说明\"></label>\n              <div class=\"form-grid two\">\n                <label>渠道 <select id=\"notification-policy-channel\" required></select></label>\n                <label>优先级 <input id=\"notification-policy-rule-priority\" type=\"number\" value=\"100\"></label>\n              </div>\n              <div class=\"form-grid three\">\n                <label>级别过滤\n                  <select id=\"notification-policy-severity\">\n                    <option value=\"\">全部级别</option>\n                    <option value=\"critical\">CRITICAL</option>\n                    <option value=\"high\">HIGH</option>\n                    <option value=\"medium\">MEDIUM</option>\n                    <option value=\"low\">LOW</option>\n                  </select>\n                </label>\n                <label>状态过滤\n                  <select id=\"notification-policy-status\">\n                    <option value=\"\">全部状态</option>\n                    <option value=\"open\">open</option>\n                    <option value=\"acked\">acked</option>\n                    <option value=\"triaged\">triaged</option>\n                    <option value=\"fixing\">fixing</option>\n                    <option value=\"resolved\">resolved</option>\n                    <option value=\"closed\">closed</option>\n                    <option value=\"noise\">noise</option>\n                  </select>\n                </label>\n                <label>原因过滤\n                  <select id=\"notification-policy-reason\">\n                    <option value=\"\">全部原因</option>\n                    <option value=\"created\">created</option>\n                    <option value=\"reopened\">reopened</option>\n                    <option value=\"event\">event</option>\n                  </select>\n                </label>\n              </div>\n              <label class=\"checkbox-label\"><input type=\"checkbox\" id=\"notification-policy-enabled\" checked> 启用</label>\n              <label class=\"checkbox-label\"><input type=\"checkbox\" id=\"notification-policy-default\"> 作为默认策略</label>\n              <div class=\"dialog-actions\">\n                <button type=\"submit\" class=\"btn btn-primary\" id=\"notification-policy-save\">保存</button>\n                <button type=\"button\" id=\"notification-policy-cancel\" class=\"btn btn-secondary\">取消</button>\n              </div>\n            </form>\n          </dialog>\n          <dialog id=\"notification-route-dialog\" class=\"app-dialog\">\n            <form id=\"notification-route-form\" method=\"dialog\">\n              <h3>服务通知</h3>\n              <input type=\"hidden\" id=\"notification-route-id\">\n              <label>服务\n                <input id=\"notification-route-service\" required placeholder=\"输入或选择服务\" list=\"notification-route-service-options\">\n                <datalist id=\"notification-route-service-options\"></datalist>\n              </label>\n              <label>通知策略 <select id=\"notification-route-policy\" required></select></label>\n              <p class=\"dialog-hint\">服务会按所选通知策略发送；未单独配置的服务继续走默认策略。</p>\n              <label class=\"checkbox-label\"><input type=\"checkbox\" id=\"notification-route-enabled\" checked> 启用</label>\n              <div class=\"dialog-actions\">\n                <button type=\"submit\" class=\"btn btn-primary\" id=\"notification-route-save\">保存</button>\n                <button type=\"button\" id=\"notification-route-cancel\" class=\"btn btn-secondary\">取消</button>\n              </div>\n            </form>\n          </dialog>\n        </section>\n\n        <section id=\"page-diagnostics\" class=\"page\">\n          <div class=\"page-toolbar\">\n            <p class=\"hint\">检查 webhook、CLS 补齐任务和通知投递的最近 24 小时健康状态</p>\n            <button id=\"diagnostics-refresh\" class=\"btn btn-primary\" type=\"button\">刷新诊断</button>\n          </div>\n          <div id=\"diagnostics-loading\" class=\"state state-loading\">加载接入诊断…</div>\n          <div id=\"diagnostics-error\" class=\"state error hidden\"></div>\n          <div id=\"diagnostics-content\" class=\"hidden\">\n            <div class=\"diagnostics-grid\">\n              <div class=\"panel\">\n                <div class=\"panel-header\"><h2>Webhook 链路</h2></div>\n                <div id=\"diag-webhook\" class=\"diag-list\"></div>\n              </div>\n              <div class=\"panel\">\n                <div class=\"panel-header\"><h2>CLS 补齐</h2></div>\n                <div id=\"diag-enrichment\" class=\"diag-list\"></div>\n              </div>\n              <div class=\"panel\">\n                <div class=\"panel-header\"><h2>通知投递</h2></div>\n                <div id=\"diag-notification\" class=\"diag-list\"></div>\n              </div>\n            </div>\n            <div class=\"panel\">\n              <div class=\"panel-header\"><h2>最近通知失败</h2></div>\n              <div class=\"table-scroll\">\n                <table class=\"table table-compact\" id=\"diag-notification-failures\">\n                  <thead>\n                    <tr>\n                      <th>时间</th>\n                      <th>Case</th>\n                      <th>原因</th>\n                      <th>服务</th>\n                      <th>渠道</th>\n                      <th>错误</th>\n                    </tr>\n                  </thead>\n                  <tbody></tbody>\n                </table>\n              </div>\n            </div>\n          </div>\n        </section>\n\n        <section id=\"page-ingest\" class=\"page\">\n          <p class=\"hint\">选择导入类型，粘贴 JSON 用于本地验证或补数。生产告警请配置 CLS 自定义回调至 <code>POST /api/webhooks/tencent-cls</code>，或通用 webhook 至 <code>POST /api/webhooks/generic</code>。</p>\n          <div class=\"toolbar filters\">\n            <select id=\"ingest-type\" aria-label=\"导入类型\">\n              <option value=\"tencent-cls\">Tencent CLS</option>\n              <option value=\"generic\">Generic Webhook</option>\n            </select>\n            <button id=\"ingest-load-sample\" class=\"btn btn-secondary\" type=\"button\">加载样例</button>\n          </div>\n          <textarea id=\"ingest-body\" rows=\"14\" placeholder='{\"service\":\"goods-http\", ...}' aria-label=\"导入 JSON\"></textarea>\n          <div class=\"ingest-actions\">\n            <button id=\"ingest-submit\" class=\"btn btn-primary\" type=\"button\">导入</button>\n          </div>\n          <div id=\"ingest-loading\" class=\"state state-loading hidden\">导入中…</div>\n          <div id=\"ingest-error\" class=\"state error hidden\"></div>\n          <div id=\"ingest-success\" class=\"state success hidden\"></div>\n          <details class=\"detail-collapse hidden\" id=\"ingest-result-wrap\">\n            <summary>导入结果详情</summary>\n            <pre id=\"ingest-result\" class=\"code\"></pre>\n          </details>\n        </section>\n      </main>\n    </div>\n  </div>\n\n  <div id=\"toast\" class=\"toast hidden\" role=\"status\" aria-live=\"polite\"></div>\n  \n"